// Number of records.
Row Count = COUNTROWS('Data')

Total product_revenue = SUM('Data'[product_revenue])

Average product_revenue = AVERAGE('Data'[product_revenue])

// Better than average when the column is skewed.
Median product_revenue = MEDIAN('Data'[product_revenue])

// Use with a bar chart on this column to reproduce the Pareto view.
Share of product_revenue by sales_channel = DIVIDE([Total product_revenue], CALCULATE([Total product_revenue], ALL('Data'[sales_channel])))

// Use with a bar chart on this column to reproduce the Pareto view.
Share of product_revenue by payment_method = DIVIDE([Total product_revenue], CALCULATE([Total product_revenue], ALL('Data'[payment_method])))

// Needs a continuous date column; mark a Date table if you add one.
product_revenue Prior Month = CALCULATE([Total product_revenue], DATEADD('Data'[order_date], -1, MONTH))

// Format as percentage.
product_revenue MoM % = DIVIDE([Total product_revenue] - [product_revenue Prior Month], [product_revenue Prior Month])

product_revenue YTD = TOTALYTD([Total product_revenue], 'Data'[order_date])
