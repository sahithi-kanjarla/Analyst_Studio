# Copy to backend/.env and run:  uvicorn app.main:app --env-file .env --port 8000
# (--env-file needs python-dotenv, which is in requirements.txt)

# auto (default) | none | ollama | gemini | groq
LLM_PROVIDER=auto
# Optional: override the default model for the chosen provider
# LLM_MODEL=qwen2.5:7b

# Free-tier keys (only the one you use)
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Limits
# MAX_UPLOAD_MB=50
# MAX_ROWS=500000       # rows per table; larger files are refused with a message
# RETENTION_DAYS=30    # runs and uploads older than this are deleted (0 = keep)
# CHATBOT=auto        # auto (default): 'Ask about this report' is on when an AI model is configured, and always on for the sample run; 'on' or 'off' to force it
# MAX_ITERATIONS=1      # critic -> analyst follow-up rounds
# RUNS_DIR=./data/runs
