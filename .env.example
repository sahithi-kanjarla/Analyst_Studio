# Copy to .env (project root, next to docker-compose.yml) and fill in what you need. Never commit .env: it is in .gitignore.
# For local development without Docker you can also copy it to backend/.env.

# ---- AI model (all optional: with none of these the app runs rules-only and still makes a full report) ----
# auto (default) | none | ollama | gemini | groq
LLM_PROVIDER=auto
# Override the provider's default model (free-tier model names change over time)
# LLM_MODEL=openai/gpt-oss-120b
# Lens: a smaller model (of the same provider) for the planning call only; wording and checks are unchanged. Default: the model above.
# LENS_PLANNER_MODEL=
# Only the key of the provider you use. Leave empty here and set the real value only in your private .env.
GROQ_API_KEY=
GOOGLE_API_KEY=
# Ollama server (local models)
# OLLAMA_HOST=http://localhost:11434

# ---- Serving ----
# Port the server listens on (one port serves the API and the pages)
PORT=8000
# production: no cross-origin site is allowed unless listed below
APP_ENV=production
# The site's own address (for example https://studio.example.com). Only needed when the page and the API are on different origins; the same origin needs nothing. CORS_ORIGINS adds more, comma-separated.
# SITE_ORIGIN=
# CORS_ORIGINS=
# Where everything is stored (runs, uploads, glossary, AI cache): mount this folder as a volume. The Docker image uses /data.
# DATA_DIR=./data

# ---- Public demo ----
# on: runs are kept 3 days, uploads and typed Lens questions need UPLOADS_REQUIRE_CODE (and are closed while it is empty), daily caps default to 10 AI analyses and 60 Lens questions. The sample report stays open and makes no AI call.
PUBLIC_DEMO=off

# ---- Public-use protections (safe defaults; see README "Deploy") ----
# When set, uploads, AI runs and typed Lens questions need this access code, entered on the upload panel. The sample report stays open to everyone.
UPLOADS_REQUIRE_CODE=
# Most analyses that use the AI per day across all visitors (0 = no cap)
# DAILY_AI_RUNS=100       (10 on a public demo)
# Most Lens questions that use the AI per day across all visitors (0 = no cap)
# DAILY_LENS_QUESTIONS=500   (60 on a public demo)
# Uploads one visitor may start per window (0 = no limit), and the window in seconds
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_S=3600
# 1 = tell visitors apart by X-Forwarded-For (only when a proxy you control sets it); 0 = use the connecting address
TRUST_PROXY_HEADERS=0

# ---- Request pacing (keeps AI calls inside a per-minute token window, so fewer rate-limit retries) ----
# Tokens per window. Default 6000 (free Groq tier) when the provider is Groq; no pacing for other providers unless set; 0 = off
# AI_TPM_LIMIT=6000
# AI_TPM_WINDOW_S=60
# Share of the window to fill, and the tokens reserved for each reply
# AI_TPM_MARGIN=0.9
# AI_REPLY_TOKENS=600

# ---- PDF export (briefs and the report) ----
# Path of a Chrome, Chromium or Edge for the server-side PDF. The Docker image sets it; elsewhere it is found automatically when one is installed.
# BROWSER_PATH=/usr/bin/chromium

# ---- Lens (the chat) ----
# auto (default): on when an AI model is configured, always on for the sample run; on | off to force it
# CHATBOT=auto
# Questions per run that may use the AI
# LENS_MAX_QUESTIONS=50

# ---- Limits ----
# MAX_UPLOAD_MB=50       # total size of the files of one run
# MAX_FILES=8
# MAX_ROWS=500000        # rows per table; larger files are refused with a message
# RETENTION_DAYS=30      # runs and uploads older than this are deleted (0 = keep forever)
# MAX_ITERATIONS=1       # critic -> analyst follow-up rounds
# CHART_DPI=140          # lower it to draw charts faster

# ---- Where things are stored (the Docker setup keeps all of them in the "analyst-data" volume) ----
# RUNS_DIR=./data/runs
# GLOSSARY_PATH=./data/glossary.json
# AI_CACHE_DIR=./data/ai_cache
# AI_CACHE=on            # off turns the saved-AI-reply cache off
# CACHE_DAYS=30           # saved AI replies older than this many days are ignored
